@model PreConHub.Models.ViewModels.CreateUnitViewModel
@{
    ViewData["Title"] = "Edit Unit";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">
            <!-- Header -->
            <div class="mb-4">
                <nav aria-label="breadcrumb">
                    <ol class="breadcrumb">
                        <li class="breadcrumb-item"><a href="@Url.Action("Index", "Projects")">Projects</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Dashboard", "Projects", new { id = Model.ProjectId })">@ViewBag.ProjectName</a></li>
                        <li class="breadcrumb-item"><a href="@Url.Action("Details", "Units", new { id = ViewBag.UnitId })">Unit @Model.UnitNumber</a></li>
                        <li class="breadcrumb-item active">Edit</li>
                    </ol>
                </nav>
                <h1 class="h3 mb-1">Edit Unit @Model.UnitNumber</h1>
                <p class="text-muted">Update unit details for @ViewBag.ProjectName</p>
            </div>

            <!-- Form Card -->
            <div class="card border-0 shadow-sm">
                <div class="card-body p-4">
                    <form asp-action="Edit" asp-route-id="@ViewBag.UnitId" method="post">
                        <input type="hidden" asp-for="ProjectId" />
                        <div asp-validation-summary="ModelOnly" class="alert alert-danger" role="alert"></div>

                        <!-- Unit Information -->
                        <h5 class="mb-3 pb-2 border-bottom">
                            <i class="bi bi-house-door me-2 text-primary"></i>Unit Information
                        </h5>
                        
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="UnitNumber" class="form-label">Unit Number <span class="text-danger">*</span></label>
                                <input asp-for="UnitNumber" class="form-control" />
                                <span asp-validation-for="UnitNumber" class="text-danger"></span>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="FloorNumber" class="form-label">Floor</label>
                                <input asp-for="FloorNumber" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="UnitType" class="form-label">Unit Type</label>
                                <select asp-for="UnitType" class="form-select" asp-items="Html.GetEnumSelectList<PreConHub.Models.Entities.UnitType>()">
                                </select>
                            </div>
                        </div>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="Bedrooms" class="form-label">Bedrooms</label>
                                <input asp-for="Bedrooms" type="number" class="form-control" min="0" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="Bathrooms" class="form-label">Bathrooms</label>
                                <input asp-for="Bathrooms" type="number" class="form-control" min="1" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="SquareFootage" class="form-label">Square Footage</label>
                                <input asp-for="SquareFootage" type="number" step="0.01" class="form-control" />
                            </div>
                        </div>

                        <!-- Pricing -->
                        <h5 class="mb-3 pb-2 border-bottom mt-4">
                            <i class="bi bi-currency-dollar me-2 text-primary"></i>Pricing
                        </h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="PurchasePrice" class="form-label">Purchase Price (APS) <span class="text-danger">*</span></label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="PurchasePrice" type="number" step="0.01" class="form-control" />
                                </div>
                                <span asp-validation-for="PurchasePrice" class="text-danger"></span>
                            </div>
                        </div>

                        <!-- Parking & Locker -->
                        <div class="row mb-3">
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input asp-for="HasParking" class="form-check-input" type="checkbox" id="hasParking" onchange="toggleParkingPrice()" />
                                    <label class="form-check-label" for="hasParking">Includes Parking</label>
                                </div>
                                <div id="parkingPriceDiv">
                                    <label asp-for="ParkingPrice" class="form-label">Parking Price</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="ParkingPrice" type="number" step="0.01" class="form-control" />
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-6">
                                            <label asp-for="ParkingCount" class="form-label">Parking Spots</label>
                                            <input asp-for="ParkingCount" type="number" class="form-control" min="0" />
                                        </div>
                                        <div class="col-6">
                                            <label asp-for="ParkingNumber" class="form-label">Parking #</label>
                                            <input asp-for="ParkingNumber" class="form-control" placeholder="e.g., P1-23" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="col-md-6">
                                <div class="form-check mb-2">
                                    <input asp-for="HasLocker" class="form-check-input" type="checkbox" id="hasLocker" onchange="toggleLockerPrice()" />
                                    <label class="form-check-label" for="hasLocker">Includes Locker</label>
                                </div>
                                <div id="lockerPriceDiv">
                                    <label asp-for="LockerPrice" class="form-label">Locker Price</label>
                                    <div class="input-group">
                                        <span class="input-group-text">$</span>
                                        <input asp-for="LockerPrice" type="number" step="0.01" class="form-control" />
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-6">
                                            <label asp-for="LockerCount" class="form-label">Lockers</label>
                                            <input asp-for="LockerCount" type="number" class="form-control" min="0" />
                                        </div>
                                        <div class="col-6">
                                            <label asp-for="LockerNumber" class="form-label">Locker #</label>
                                            <input asp-for="LockerNumber" class="form-control" placeholder="e.g., L-15" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Dates -->
                        <h5 class="mb-3 pb-2 border-bottom mt-4">
                            <i class="bi bi-calendar me-2 text-primary"></i>Dates
                        </h5>

                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="APSDate" class="form-label">APS Signing Date</label>
                                <input asp-for="APSDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="OccupancyDate" class="form-label">Occupancy Date</label>
                                <input asp-for="OccupancyDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="ClosingDate" class="form-label">Closing Date</label>
                                <input asp-for="ClosingDate" type="date" class="form-control" />
                            </div>
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="FirmClosingDate" class="form-label">Firm Closing Date</label>
                                <input asp-for="FirmClosingDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-4">
                                <label asp-for="InterimOccupancyStartDate" class="form-label">Interim Occupancy Start</label>
                                <input asp-for="InterimOccupancyStartDate" type="date" class="form-control" />
                            </div>
                        </div>

                        <!-- Tarion Dates -->
                        <h5 class="mb-3 pb-2 border-bottom mt-4">
                            <i class="bi bi-shield-check me-2 text-primary"></i>Tarion Dates
                        </h5>

                        <div class="row mb-3">
                            <div class="col-md-6">
                                <label asp-for="FirstTentativeOccupancyDate" class="form-label">First Tentative Occupancy</label>
                                <input asp-for="FirstTentativeOccupancyDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="OutsideOccupancyDate" class="form-label">Outside Occupancy Date</label>
                                <input asp-for="OutsideOccupancyDate" type="date" class="form-control" />
                            </div>
                        </div>
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="DelayedOccupancyDate" class="form-label">Delayed Occupancy Date</label>
                                <input asp-for="DelayedOccupancyDate" type="date" class="form-control" />
                            </div>
                            <div class="col-md-6">
                                <label asp-for="PurchaserTerminationDate" class="form-label">Purchaser Termination Date</label>
                                <input asp-for="PurchaserTerminationDate" type="date" class="form-control" />
                            </div>
                        </div>

                        <!-- Occupancy Fee -->
                        <h5 class="mb-3 pb-2 border-bottom mt-4">
                            <i class="bi bi-house-check me-2 text-primary"></i>Occupancy Fee
                        </h5>
                        <div class="alert alert-light border small mb-3">
                            <i class="bi bi-info-circle me-1"></i>
                            Monthly fee during interim occupancy: interest on unpaid balance + common expenses + property taxes.
                        </div>
                        <div class="row mb-3">
                            <div class="col-md-3">
                                <label asp-for="OccupancyFeeInterestRate" class="form-label">Interest Rate (%)</label>
                                <input asp-for="OccupancyFeeInterestRate" type="number" step="0.0001" min="0" max="1" class="form-control" placeholder="e.g., 0.0425" />
                                <div class="form-text">Annual rate as decimal</div>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="OccupancyFeeEstCommonExpense" class="form-label">Est. Common Expense</label>
                                <div class="input-group"><span class="input-group-text">$</span><input asp-for="OccupancyFeeEstCommonExpense" type="number" step="0.01" min="0" class="form-control" placeholder="e.g., 450" /></div>
                                <div class="form-text">Monthly</div>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="OccupancyFeeEstPropertyTax" class="form-label">Est. Property Tax</label>
                                <div class="input-group"><span class="input-group-text">$</span><input asp-for="OccupancyFeeEstPropertyTax" type="number" step="0.01" min="0" class="form-control" placeholder="e.g., 350" /></div>
                                <div class="form-text">Monthly</div>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="EstimatedMonthlyOccupancyFee" class="form-label">Est. Total Monthly</label>
                                <div class="input-group"><span class="input-group-text">$</span><input asp-for="EstimatedMonthlyOccupancyFee" type="number" step="0.01" min="0" class="form-control" placeholder="e.g., 2500" /></div>
                                <div class="form-text">Total monthly occupancy fee</div>
                            </div>
                        </div>

                        <!-- Upgrade Charges -->
                        <h5 class="mb-3 pb-2 border-bottom mt-4">
                            <i class="bi bi-tools me-2 text-primary"></i>Upgrade Charges
                        </h5>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="UpgradeAmount" class="form-label">Upgrade Amount</label>
                                <div class="input-group"><span class="input-group-text">$</span><input asp-for="UpgradeAmount" type="number" step="0.01" min="0" class="form-control" placeholder="e.g., 25000" /></div>
                                <div class="form-text">Total purchaser-selected upgrades from APS</div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="UpgradePaidDate" class="form-label">Paid Date</label>
                                <input asp-for="UpgradePaidDate" type="date" class="form-control" />
                            </div>
                        </div>

                        <!-- Builder-Provided Unit Fees -->
                        <h5 class="mb-3 pb-2 border-bottom mt-4">
                            <i class="bi bi-currency-dollar me-2 text-primary"></i>Development Fee & Meters
                        </h5>
                        <div class="row mb-3">
                            <div class="col-md-4">
                                <label asp-for="DevelopmentFee" class="form-label">Development Fee</label>
                                <div class="input-group"><span class="input-group-text">$</span><input asp-for="DevelopmentFee" type="number" step="0.01" min="0" class="form-control" placeholder="e.g., 15000" /></div>
                            </div>
                            <div class="col-md-4">
                                <label asp-for="MetersFee" class="form-label">Meters</label>
                                <div class="input-group"><span class="input-group-text">$</span><input asp-for="MetersFee" type="number" step="0.01" min="0" class="form-control" placeholder="e.g., 3500" /></div>
                            </div>
                        </div>

                        <!-- SOA Fields -->
                        <h5 class="mb-3 pb-2 border-bottom mt-4">
                            <i class="bi bi-receipt me-2 text-primary"></i>SOA Fields
                        </h5>

                        <div class="row mb-3">
                            <div class="col-md-3">
                                <div class="form-check mt-2">
                                    <input asp-for="IsFirstTimeBuyer" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsFirstTimeBuyer" class="form-check-label">First-Time Buyer</label>
                                </div>
                                <div class="form-text">Affects LTT rebate calculation</div>
                            </div>
                            <div class="col-md-3">
                                <div class="form-check mt-2">
                                    <input asp-for="IsPrimaryResidence" class="form-check-input" type="checkbox" />
                                    <label asp-for="IsPrimaryResidence" class="form-check-label">Primary Residence</label>
                                </div>
                                <div class="form-text">Affects HST rebate eligibility</div>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="ActualAnnualLandTax" class="form-label">Annual Land Tax</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="ActualAnnualLandTax" type="number" step="0.01" min="0" class="form-control" placeholder="e.g., 5200" />
                                </div>
                                <div class="form-text">Blank = 1% estimate</div>
                            </div>
                            <div class="col-md-3">
                                <label asp-for="ActualMonthlyMaintenanceFee" class="form-label">Monthly Maintenance</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="ActualMonthlyMaintenanceFee" type="number" step="0.01" min="0" class="form-control" placeholder="e.g., 450" />
                                </div>
                                <div class="form-text">Blank = $0.60/sqft</div>
                            </div>
                        </div>

                        <!-- Late Closing Penalty -->
                        <h5 class="mb-3 pb-2 border-bottom mt-4">
                            <i class="bi bi-exclamation-triangle me-2 text-danger"></i>Late Closing Penalty
                        </h5>
                        <div class="row mb-4">
                            <div class="col-md-6">
                                <label asp-for="DailyPenaltyAmount" class="form-label">Daily Penalty Amount</label>
                                <div class="input-group">
                                    <span class="input-group-text">$</span>
                                    <input asp-for="DailyPenaltyAmount" type="number" step="0.01" min="0" class="form-control" placeholder="e.g. 150.00" />
                                    <span class="input-group-text">/day</span>
                                </div>
                                <div class="form-text">Daily penalty charged if closing is late. Leave empty to disable.</div>
                            </div>
                        </div>

                        <!-- Buttons -->
                        <div class="d-flex justify-content-between">
                            <div>
                                <a href="@Url.Action("Details", "Units", new { id = ViewBag.UnitId })" class="btn btn-outline-secondary">
                                    <i class="bi bi-arrow-left me-2"></i>Cancel
                                </a>
                            </div>
                            <div>
                                <button type="button" class="btn btn-outline-danger me-2" data-bs-toggle="modal" data-bs-target="#deleteModal">
                                    <i class="bi bi-trash me-1"></i>Delete Unit
                                </button>
                                <button type="submit" class="btn btn-primary">
                                    <i class="bi bi-check-lg me-2"></i>Save Changes
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1">
    <div class="modal-dialog">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title text-danger"><i class="bi bi-exclamation-triangle me-2"></i>Delete Unit</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <p>Are you sure you want to delete <strong>Unit @Model.UnitNumber</strong>?</p>
                <p class="text-danger mb-0">This action cannot be undone. All associated data (deposits, SOA, purchaser info) will be permanently deleted.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-route-id="@ViewBag.UnitId" method="post" class="d-inline">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Yes, Delete Unit
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
        function toggleParkingPrice() {
            var checkbox = document.getElementById('hasParking');
            var priceDiv = document.getElementById('parkingPriceDiv');
            priceDiv.style.display = checkbox.checked ? 'block' : 'none';
        }

        function toggleLockerPrice() {
            var checkbox = document.getElementById('hasLocker');
            var priceDiv = document.getElementById('lockerPriceDiv');
            priceDiv.style.display = checkbox.checked ? 'block' : 'none';
        }

        // Initialize on page load
        document.addEventListener('DOMContentLoaded', function() {
            toggleParkingPrice();
            toggleLockerPrice();
        });
    </script>
}
