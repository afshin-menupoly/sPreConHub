@model PreConHub.Models.ViewModels.RecordAssignmentViewModel

@{
    ViewData["Title"] = $"Record Assignment — Unit {Model.UnitNumber}";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Projects" asp-action="Index">Projects</a></li>
        <li class="breadcrumb-item"><a asp-controller="Projects" asp-action="Dashboard" asp-route-id="@Model.ProjectId">@Model.ProjectName</a></li>
        <li class="breadcrumb-item"><a asp-controller="Units" asp-action="Details" asp-route-id="@Model.UnitId">Unit @Model.UnitNumber</a></li>
        <li class="breadcrumb-item active">Record Assignment</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0"><i class="bi bi-arrow-left-right me-2"></i>Record APS Assignment — Unit @Model.UnitNumber</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info mb-3">
                    <i class="bi bi-info-circle me-1"></i>
                    Recording an assignment will add the APS assignment fee (typically $1,500 + HST) to the SOA.
                    Make sure the assignment fee is configured in Project Fees.
                </div>

                <form asp-action="RecordAssignment" asp-route-id="@Model.UnitId" method="post">
                    <input type="hidden" asp-for="UnitId" />

                    <div class="mb-3">
                        <label asp-for="AssigneeName" class="form-label fw-bold">Assignee Name (New Buyer)</label>
                        <input asp-for="AssigneeName" class="form-control" placeholder="Full name of the assignee" />
                        <span asp-validation-for="AssigneeName" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="AssignmentDate" class="form-label fw-bold">Assignment Date</label>
                        <input asp-for="AssignmentDate" type="date" class="form-control" />
                        <span asp-validation-for="AssignmentDate" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Units" asp-action="Details" asp-route-id="@Model.UnitId" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-info text-white">
                            <i class="bi bi-check-lg me-1"></i>Record Assignment
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
