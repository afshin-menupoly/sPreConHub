@model PreConHub.Models.ViewModels.RecordNSFViewModel

@{
    ViewData["Title"] = $"Record NSF — Unit {Model.UnitNumber}";
}

<nav aria-label="breadcrumb" class="mb-3">
    <ol class="breadcrumb">
        <li class="breadcrumb-item"><a asp-controller="Projects" asp-action="Index">Projects</a></li>
        <li class="breadcrumb-item"><a asp-controller="Projects" asp-action="Dashboard" asp-route-id="@Model.ProjectId">@Model.ProjectName</a></li>
        <li class="breadcrumb-item"><a asp-controller="Units" asp-action="Details" asp-route-id="@Model.UnitId">Unit @Model.UnitNumber</a></li>
        <li class="breadcrumb-item active">Record NSF</li>
    </ol>
</nav>

<div class="row justify-content-center">
    <div class="col-lg-6">
        <div class="card shadow-sm">
            <div class="card-header bg-danger text-white">
                <h5 class="mb-0"><i class="bi bi-x-circle me-2"></i>Record Bounced Cheque (NSF) — Unit @Model.UnitNumber</h5>
            </div>
            <div class="card-body">
                <div class="alert alert-info mb-3">
                    <i class="bi bi-cash-stack me-1"></i>
                    <strong>Deposit:</strong> @Model.DepositName — @Model.DepositAmount.ToString("C")
                </div>

                <div class="alert alert-warning mb-3">
                    <i class="bi bi-exclamation-triangle me-1"></i>
                    Recording an NSF will mark the deposit as <strong>Bounced</strong>, add a $500 + HST ($565) fee to the SOA,
                    and trigger 24% annual default interest from the bounce date.
                </div>

                <form asp-action="RecordNSF" asp-route-id="@Model.UnitId" method="post">
                    <input type="hidden" asp-for="UnitId" />
                    <input type="hidden" asp-for="DepositId" />

                    <div class="mb-3">
                        <label asp-for="BounceDate" class="form-label fw-bold">Bounce Date</label>
                        <input asp-for="BounceDate" type="date" class="form-control" />
                        <span asp-validation-for="BounceDate" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="FeeAmount" class="form-label fw-bold">NSF Fee (before HST)</label>
                        <div class="input-group">
                            <span class="input-group-text">$</span>
                            <input asp-for="FeeAmount" type="number" step="0.01" min="0" class="form-control" />
                        </div>
                        <span asp-validation-for="FeeAmount" class="text-danger"></span>
                        <div class="form-text">Default: $500. HST (13%) will be added automatically = $565 total.</div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Notes" class="form-label fw-bold">Notes (optional)</label>
                        <textarea asp-for="Notes" class="form-control" rows="3" placeholder="Additional details about the NSF..."></textarea>
                        <span asp-validation-for="Notes" class="text-danger"></span>
                    </div>

                    <div class="d-flex justify-content-between">
                        <a asp-controller="Units" asp-action="Details" asp-route-id="@Model.UnitId" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Cancel
                        </a>
                        <button type="submit" class="btn btn-danger">
                            <i class="bi bi-x-circle me-1"></i>Record NSF Charge
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>
