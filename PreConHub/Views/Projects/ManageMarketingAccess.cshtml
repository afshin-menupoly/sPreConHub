@{
    ViewData["Title"] = "Manage Marketing Access";
    var projectId = (int)ViewBag.ProjectId;
    var projectName = (string)ViewBag.ProjectName;
    var allowAccess = (bool)ViewBag.AllowMarketingAccess;
    var selectedUserId = (string?)ViewBag.MarketingAgencyUserId;
    var maUsers = (List<PreConHub.Models.Entities.ApplicationUser>)ViewBag.MAUsers;
}

<div class="container py-4" style="max-width: 800px;">
    <nav aria-label="breadcrumb">
        <ol class="breadcrumb mb-3">
            <li class="breadcrumb-item"><a asp-action="Index">Projects</a></li>
            <li class="breadcrumb-item"><a asp-action="Dashboard" asp-route-id="@projectId">@projectName</a></li>
            <li class="breadcrumb-item active">Marketing Access</li>
        </ol>
    </nav>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-circle me-2"></i>@TempData["Error"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["InvitationLink"] != null)
    {
        <div class="alert alert-info alert-dismissible fade show" role="alert">
            <i class="bi bi-link-45deg me-2"></i><strong>Invitation Link:</strong>
            <br><code class="user-select-all">@TempData["InvitationLink"]</code>
            <div class="form-text mt-1">Share this link with the MA user so they can set their password and log in.</div>
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <div class="card border-0 shadow-sm">
        <div class="card-header bg-warning text-dark">
            <h5 class="mb-0"><i class="bi bi-megaphone me-2"></i>Marketing Agency Access — @projectName</h5>
        </div>
        <div class="card-body">
            <!-- Toggle Switch -->
            <div class="mb-4">
                <div class="form-check form-switch">
                    <input class="form-check-input" type="checkbox" role="switch"
                           id="allowAccess" name="allowAccessToggle" value="true"
                           @(allowAccess ? "checked" : "")
                           onchange="toggleMASection(this.checked)">
                    <label class="form-check-label fw-bold" for="allowAccess">
                        Enable Marketing Agency Access
                    </label>
                </div>
                <div class="form-text">When enabled, the assigned marketing agency user can view unit pricing and suggest discounts/credits for this project.</div>
            </div>

            <!-- MA User Section (shown when toggle is on) -->
            <div id="maUserSection" style="display: @(allowAccess ? "block" : "none");">

                <!-- Select Existing MA User -->
                <div class="card border mb-3">
                    <div class="card-body p-3">
                        <h6 class="mb-3 pb-2 border-bottom">
                            <i class="bi bi-search me-2 text-primary"></i>Select Existing Marketing Agency User
                        </h6>
                        <div class="mb-3">
                            <input type="text" id="maSearch" class="form-control" placeholder="Search by name or company (min 3 characters)..." />
                            <div class="form-text">Type at least 3 characters to search by first name, last name, or company</div>
                        </div>
                        <div id="maListContainer" style="display:none;">
                            <div class="table-responsive" style="max-height: 480px; overflow-y: auto;">
                                <table class="table table-hover table-sm align-middle mb-0">
                                    <thead class="table-light sticky-top">
                                        <tr>
                                            <th>Name</th>
                                            <th>Company</th>
                                            <th>Assigned Projects</th>
                                            <th style="width: 90px;"></th>
                                        </tr>
                                    </thead>
                                    <tbody id="maTableBody"></tbody>
                                </table>
                            </div>
                            <nav id="maPagination" class="mt-2">
                                <ul class="pagination pagination-sm justify-content-center mb-0"></ul>
                            </nav>
                        </div>
                        <div id="noMASearchResults" style="display:none;" class="text-muted text-center py-3">
                            <i class="bi bi-search me-1"></i>No MA users found matching your search.
                        </div>
                        <div id="noMAUsers" style="display:none;" class="text-muted text-center py-3">
                            <i class="bi bi-info-circle me-1"></i>No existing MA users found for your projects.
                        </div>
                    </div>
                </div>

                <!-- Hidden form for selecting existing MA user -->
                <form id="selectMAForm" asp-action="ManageMarketingAccess" asp-route-id="@projectId" method="post" style="display:none;">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="allowAccess" value="true" />
                    <input type="hidden" name="marketingAgencyUserId" id="selectedMAUserId" />
                </form>

                <!-- Divider -->
                <div class="text-center my-3">
                    <span class="text-muted small">&mdash; OR create a new MA user &mdash;</span>
                </div>

                <!-- Create New MA User (inline) -->
                <div class="card border">
                    <div class="card-body p-3">
                        <h6 class="mb-3 pb-2 border-bottom">
                            <i class="bi bi-person-plus me-2 text-primary"></i>New Marketing Agency User
                        </h6>
                        <form asp-action="CreateMarketingAgencyUser" asp-route-id="@projectId" method="post">
                            @Html.AntiForgeryToken()

                            <div class="row g-3 mb-3">
                                <div class="col-md-6">
                                    <label for="maFirstName" class="form-label">First Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="maFirstName" name="maFirstName" required>
                                </div>
                                <div class="col-md-6">
                                    <label for="maLastName" class="form-label">Last Name <span class="text-danger">*</span></label>
                                    <input type="text" class="form-control" id="maLastName" name="maLastName" required>
                                </div>
                            </div>
                            <div class="mb-3">
                                <label for="maEmail" class="form-label">Email <span class="text-danger">*</span></label>
                                <input type="email" class="form-control" id="maEmail" name="maEmail" required>
                            </div>
                            <div class="mb-3">
                                <label for="maCompanyName" class="form-label">Company Name</label>
                                <input type="text" class="form-control" id="maCompanyName" name="maCompanyName" placeholder="Optional">
                            </div>

                            <button type="submit" class="btn btn-success">
                                <i class="bi bi-person-plus me-1"></i>Create MA User
                            </button>
                        </form>
                    </div>
                </div>
            </div>

            <!-- Disable access form -->
            <div id="disableSection" style="display: @(allowAccess ? "none" : "block");">
                <form asp-action="ManageMarketingAccess" asp-route-id="@projectId" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="allowAccess" value="false" />
                    <div class="d-flex justify-content-between">
                        <a asp-action="Dashboard" asp-route-id="@projectId" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Back
                        </a>
                        <button type="submit" class="btn btn-primary">
                            <i class="bi bi-save me-1"></i>Save
                        </button>
                    </div>
                </form>
            </div>

            @if (allowAccess)
            {
                <div class="d-flex justify-content-between mt-4">
                    <a asp-action="Dashboard" asp-route-id="@projectId" class="btn btn-outline-secondary">
                        <i class="bi bi-arrow-left me-1"></i>Back
                    </a>
                    <form asp-action="ManageMarketingAccess" asp-route-id="@projectId" method="post" class="d-inline">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="allowAccess" value="false" />
                        <button type="submit" class="btn btn-outline-danger" onclick="return confirm('This will revoke Marketing Agency access for this project. Continue?');">
                            <i class="bi bi-x-circle me-1"></i>Revoke Access
                        </button>
                    </form>
                </div>
            }
        </div>
    </div>
</div>

@section Scripts {
<script>
(function () {
    const PAGE_SIZE = 10;
    const allMAUsers = @Html.Raw(ViewBag.ExistingMAUsersJson ?? "[]");
    let filtered = [];
    let currentPage = 1;

    const searchInput = document.getElementById('maSearch');
    const listContainer = document.getElementById('maListContainer');
    const tableBody = document.getElementById('maTableBody');
    const paginationUl = document.querySelector('#maPagination ul');
    const noResults = document.getElementById('noMASearchResults');
    const noUsers = document.getElementById('noMAUsers');

    if (allMAUsers.length === 0) {
        noUsers.style.display = 'block';
        searchInput.disabled = true;
        searchInput.placeholder = 'No existing MA users available';
    }

    searchInput.addEventListener('input', function () {
        const q = this.value.trim().toLowerCase();
        if (q.length < 3) {
            listContainer.style.display = 'none';
            noResults.style.display = 'none';
            return;
        }
        filtered = allMAUsers.filter(function (u) {
            return (u.FirstName && u.FirstName.toLowerCase().startsWith(q)) ||
                   (u.LastName && u.LastName.toLowerCase().startsWith(q)) ||
                   (u.Company && u.Company.toLowerCase().startsWith(q));
        });
        currentPage = 1;
        render();
    });

    function render() {
        if (filtered.length === 0) {
            listContainer.style.display = 'none';
            noResults.style.display = 'block';
            return;
        }
        noResults.style.display = 'none';
        listContainer.style.display = 'block';

        const totalPages = Math.ceil(filtered.length / PAGE_SIZE);
        const start = (currentPage - 1) * PAGE_SIZE;
        const page = filtered.slice(start, start + PAGE_SIZE);

        tableBody.innerHTML = '';
        page.forEach(function (u) {
            const projects = u.Projects.join(', ');
            const badge = u.IsCurrentProject
                ? ' <span class="badge bg-primary-subtle text-primary-emphasis ms-1">This project</span>'
                : '';
            const tr = document.createElement('tr');
            tr.style.cursor = 'pointer';
            tr.innerHTML =
                '<td><strong>' + escHtml(u.FirstName + ' ' + u.LastName) + '</strong>' + badge +
                '<br/><small class="text-muted">' + escHtml(u.Email || '') + '</small></td>' +
                '<td>' + escHtml(u.Company || '—') + '</td>' +
                '<td class="small">' + escHtml(projects || '—') + '</td>' +
                '<td><button type="button" class="btn btn-sm btn-outline-primary select-ma-btn">Select</button></td>';
            tr.querySelector('.select-ma-btn').addEventListener('click', function () {
                selectMAUser(u);
            });
            tableBody.appendChild(tr);
        });

        // Pagination
        paginationUl.innerHTML = '';
        if (totalPages > 1) {
            addPageItem('«', currentPage > 1 ? currentPage - 1 : null);
            for (var p = 1; p <= totalPages; p++) {
                addPageItem(p.toString(), p, p === currentPage);
            }
            addPageItem('»', currentPage < totalPages ? currentPage + 1 : null);
        }
    }

    function addPageItem(label, page, active) {
        const li = document.createElement('li');
        li.className = 'page-item' + (active ? ' active' : '') + (page == null ? ' disabled' : '');
        const a = document.createElement('a');
        a.className = 'page-link';
        a.href = '#';
        a.textContent = label;
        if (page != null) {
            a.addEventListener('click', function (e) {
                e.preventDefault();
                currentPage = page;
                render();
            });
        }
        li.appendChild(a);
        paginationUl.appendChild(li);
    }

    function selectMAUser(user) {
        if (!confirm('Assign ' + user.FirstName + ' ' + user.LastName + ' (' + (user.Company || 'No company') + ') as Marketing Agency for this project?')) return;
        document.getElementById('selectedMAUserId').value = user.MAUserId;
        document.getElementById('selectMAForm').submit();
    }

    function escHtml(str) {
        var div = document.createElement('div');
        div.textContent = str;
        return div.innerHTML;
    }

    // Toggle MA section visibility
    window.toggleMASection = function (checked) {
        document.getElementById('maUserSection').style.display = checked ? 'block' : 'none';
        document.getElementById('disableSection').style.display = checked ? 'none' : 'block';
    };
})();
</script>
}
