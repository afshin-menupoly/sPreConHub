@section Scripts {
<script>
    // Per-section state
    var sectionState = {
        bl: { sort: { column: 'unit', direction: 'asc' }, page: 1, statusFilter: 'all' },
        by: { sort: { column: 'unit', direction: 'asc' }, page: 1, statusFilter: 'all' }
    };

    function copyInvitationLink() {
        var input = document.getElementById('invitationLink');
        input.select();
        document.execCommand('copy');
        var btn = event.target.closest('button');
        var originalHtml = btn.innerHTML;
        btn.innerHTML = '<i class="bi bi-check"></i> Copied!';
        setTimeout(function() { btn.innerHTML = originalHtml; }, 2000);
    }

    function filterSection(section, status) {
        sectionState[section].statusFilter = status;
        sectionState[section].page = 1;
        applySection(section);
    }

    function sortSection(section, column) {
        var state = sectionState[section];
        if (state.sort.column === column) {
            state.sort.direction = state.sort.direction === 'asc' ? 'desc' : 'asc';
        } else {
            state.sort.column = column;
            state.sort.direction = 'asc';
        }
        state.page = 1;
        updateSortIcons(section);
        applySection(section);
    }

    function updateSortIcons(section) {
        var state = sectionState[section];
        document.querySelectorAll('.sortable-header[data-section="' + section + '"] .sort-icon').forEach(function(icon) {
            icon.className = 'bi bi-arrow-down-up text-muted ms-1 sort-icon';
        });
        var activeHeader = document.querySelector('.sortable-header[data-section="' + section + '"][data-sort="' + state.sort.column + '"] .sort-icon');
        if (activeHeader) {
            activeHeader.className = 'bi ms-1 sort-icon text-primary ' +
                (state.sort.direction === 'asc' ? 'bi-sort-down-alt' : 'bi-sort-up-alt');
        }
    }

    function getVisibleRows(section) {
        var state = sectionState[section];
        var rows = Array.from(document.querySelectorAll('#' + section + 'Body .lawyer-row'));
        var searchTerm = document.getElementById(section + 'Search').value.trim().toLowerCase();

        return rows.filter(function(row) {
            if (state.statusFilter !== 'all' && row.dataset.status !== state.statusFilter) return false;
            if (searchTerm.length >= 3) {
                var name = row.dataset.name || '';
                var units = (row.dataset.units || '').toLowerCase();
                if (name.indexOf(searchTerm) === -1 && units.indexOf(searchTerm) === -1) return false;
            }
            return true;
        });
    }

    function compareRows(section, a, b) {
        var state = sectionState[section];
        var col = state.sort.column;
        var dir = state.sort.direction === 'asc' ? 1 : -1;
        var valA, valB;

        if (col === 'name') {
            valA = a.dataset.name || '';
            valB = b.dataset.name || '';
            return dir * valA.localeCompare(valB);
        } else if (col === 'unit') {
            valA = a.dataset.unitSort || '';
            valB = b.dataset.unitSort || '';
            var numA = parseInt(valA), numB = parseInt(valB);
            if (!isNaN(numA) && !isNaN(numB)) return dir * (numA - numB);
            return dir * valA.localeCompare(valB, undefined, { numeric: true });
        } else if (col === 'status') {
            valA = a.dataset.statusText || '';
            valB = b.dataset.statusText || '';
            return dir * valA.localeCompare(valB);
        }
        return 0;
    }

    function applySection(section) {
        var state = sectionState[section];
        var rows = getVisibleRows(section);
        rows.sort(function(a, b) { return compareRows(section, a, b); });

        var pageSize = parseInt(document.getElementById(section + 'PageSize').value);
        var totalRows = rows.length;
        var totalPages = Math.max(1, Math.ceil(totalRows / pageSize));
        if (state.page > totalPages) state.page = totalPages;

        var start = (state.page - 1) * pageSize;
        var end = start + pageSize;

        // Hide all rows
        document.querySelectorAll('#' + section + 'Body .lawyer-row').forEach(function(r) {
            r.style.display = 'none';
        });

        // Show current page rows in sort order
        var tbody = document.getElementById(section + 'Body');
        rows.forEach(function(row, index) {
            if (index >= start && index < end) {
                row.style.display = '';
            }
            tbody.appendChild(row);
        });

        // Update pagination info
        var info = document.getElementById(section + 'PaginationInfo');
        if (totalRows === 0) {
            info.textContent = 'No matching lawyers found';
        } else {
            info.textContent = 'Showing ' + (start + 1) + '\u2013' + Math.min(end, totalRows) + ' of ' + totalRows + ' lawyer(s)';
        }

        // Build pagination nav
        var nav = document.getElementById(section + 'PaginationNav');
        nav.innerHTML = '';
        if (totalPages <= 1) return;

        nav.innerHTML += '<li class="page-item ' + (state.page === 1 ? 'disabled' : '') + '">' +
            '<a class="page-link" href="#" onclick="goToSectionPage(\'' + section + '\',' + (state.page - 1) + '); return false;">&laquo;</a></li>';

        var startPage = Math.max(1, state.page - 3);
        var endPage = Math.min(totalPages, startPage + 6);
        if (endPage - startPage < 6) startPage = Math.max(1, endPage - 6);

        for (var i = startPage; i <= endPage; i++) {
            nav.innerHTML += '<li class="page-item ' + (i === state.page ? 'active' : '') + '">' +
                '<a class="page-link" href="#" onclick="goToSectionPage(\'' + section + '\',' + i + '); return false;">' + i + '</a></li>';
        }

        nav.innerHTML += '<li class="page-item ' + (state.page === totalPages ? 'disabled' : '') + '">' +
            '<a class="page-link" href="#" onclick="goToSectionPage(\'' + section + '\',' + (state.page + 1) + '); return false;">&raquo;</a></li>';
    }

    function goToSectionPage(section, page) {
        var state = sectionState[section];
        var pageSize = parseInt(document.getElementById(section + 'PageSize').value);
        var totalRows = getVisibleRows(section).length;
        var totalPages = Math.max(1, Math.ceil(totalRows / pageSize));
        if (page < 1 || page > totalPages) return;
        state.page = page;
        applySection(section);
    }

    // Initialize on page load
    document.addEventListener('DOMContentLoaded', function() {
        applySection('bl');
        applySection('by');
    });
</script>
}

@functions {
    string GetTimeAgo(DateTime dateTime)
    {
        var span = DateTime.UtcNow - dateTime;
        if (span.TotalMinutes < 1) return "Just now";
        if (span.TotalMinutes < 60) return $"{(int)span.TotalMinutes}m ago";
        if (span.TotalHours < 24) return $"{(int)span.TotalHours}h ago";
        if (span.TotalDays < 7) return $"{(int)span.TotalDays}d ago";
        return dateTime.ToString("MMM dd");
    }
}
