            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-person-badge text-muted" style="font-size: 4rem;"></i>
                    <h5 class="mt-3">No Buyer's Lawyers Assigned</h5>
                    <p class="text-muted">Assign buyer's lawyers to represent purchasers during closing.</p>
                    <a href="@Url.Action("BulkAssignBuyerLawyer", "Projects", new { id = Model.ProjectId })" class="btn btn-primary">
                        <i class="bi bi-plus-lg me-2"></i>Assign Buyer's Lawyer
                    </a>
                </div>
            }
        </div>
    </div>
</div>

<!-- Assignment Details Modals - Buyer's Lawyers -->
@foreach (var lawyer in Model.BuyerLawyers)
{
    <div class="modal fade" id="buyerAssignmentsModal-@lawyer.LawyerId.Replace("-", "")" tabindex="-1">
        <div class="modal-dialog">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title">@lawyer.FirstName @lawyer.LastName - Buyer's Lawyer Assignments</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <table class="table table-sm">
                        <thead>
                            <tr>
                                <th>Unit</th>
                                <th>Status</th>
                                <th>Assigned</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var assignment in lawyer.Assignments)
                            {
                                <tr>
                                    <td>
                                        <a href="@Url.Action("Details", "Units", new { id = assignment.UnitId })">
                                            Unit @assignment.UnitNumber
                                        </a>
                                    </td>
                                    <td>
                                        @{
                                            var buyerStatusClass = assignment.ReviewStatus switch
                                            {
                                                PreConHub.Models.Entities.LawyerReviewStatus.Pending => "warning",
                                                PreConHub.Models.Entities.LawyerReviewStatus.UnderReview => "info",
                                                PreConHub.Models.Entities.LawyerReviewStatus.Approved => "success",
                                                PreConHub.Models.Entities.LawyerReviewStatus.NeedsRevision => "danger",
                                                _ => "secondary"
                                            };
                                        }
                                        <span class="badge bg-@buyerStatusClass">@assignment.ReviewStatus</span>
                                    </td>
                                    <td>@assignment.AssignedAt.ToString("MMM dd")</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>
}

