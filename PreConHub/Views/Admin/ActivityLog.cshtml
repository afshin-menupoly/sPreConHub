@model PreConHub.Models.ViewModels.ActivityLogViewModel
@{
    ViewData["Title"] = "Activity Log";
}

<div class="container-fluid py-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Dashboard">Admin</a></li>
                    <li class="breadcrumb-item"><a asp-controller="Reports" asp-action="Index">Reports</a></li>
                    <li class="breadcrumb-item active">Activity Log</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0"><i class="bi bi-journal-text me-2"></i>Activity Log</h1>
        </div>
        <span class="badge bg-secondary fs-6">@Model.TotalCount entries</span>
    </div>

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3">
                <div class="col-md-2">
                    <label class="form-label">User</label>
                    <input type="text" name="searchUser" class="form-control" placeholder="Username..."
                           value="@Model.SearchUser">
                </div>
                <div class="col-md-2">
                    <label class="form-label">Action</label>
                    <select name="action" class="form-select">
                        <option value="">All Actions</option>
                        @foreach (var a in Model.AvailableActions)
                        {
                            if (Model.ActionFilter == a)
                            {
                                <option value="@a" selected>@a</option>
                            }
                            else
                            {
                                <option value="@a">@a</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Entity</label>
                    <select name="entity" class="form-select">
                        <option value="">All Entities</option>
                        @foreach (var e in Model.AvailableEntities)
                        {
                            if (Model.EntityFilter == e)
                            {
                                <option value="@e" selected>@e</option>
                            }
                            else
                            {
                                <option value="@e">@e</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">From</label>
                    <input type="date" name="dateFrom" class="form-control" value="@Model.DateFrom">
                </div>
                <div class="col-md-2">
                    <label class="form-label">To</label>
                    <input type="date" name="dateTo" class="form-control" value="@Model.DateTo">
                </div>
                <div class="col-md-2 d-flex align-items-end gap-2">
                    <button type="submit" class="btn btn-primary">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                    <a asp-action="ActivityLog" class="btn btn-outline-secondary">Clear</a>
                </div>
            </form>
        </div>
    </div>

    <!-- Log Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.Entries.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>Timestamp</th>
                                <th>User</th>
                                <th>Role</th>
                                <th>Action</th>
                                <th>Entity</th>
                                <th>Entity ID</th>
                                <th>IP Address</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var entry in Model.Entries)
                            {
                                <tr>
                                    <td>
                                        <small>@entry.Timestamp.ToString("MMM dd, yyyy HH:mm:ss")</small>
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(entry.UserName))
                                        {
                                            <strong>@entry.UserName</strong>
                                        }
                                        else
                                        {
                                            <span class="text-muted">System</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(entry.UserRole))
                                        {
                                            <span class="badge bg-info text-dark">@entry.UserRole</span>
                                        }
                                    </td>
                                    <td>
                                        @{
                                            var actionBadge = entry.Action switch
                                            {
                                                "Create" => "bg-success",
                                                "Update" => "bg-primary",
                                                "Delete" => "bg-danger",
                                                "Confirm" => "bg-info",
                                                _ => "bg-secondary"
                                            };
                                        }
                                        <span class="badge @actionBadge">@entry.Action</span>
                                    </td>
                                    <td>@entry.EntityType</td>
                                    <td><code>@entry.EntityId</code></td>
                                    <td><small class="text-muted">@(entry.IpAddress ?? "—")</small></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination -->
                @if (Model.TotalPages > 1)
                {
                    <div class="card-footer bg-white">
                        <div class="d-flex justify-content-between align-items-center">
                            <small class="text-muted">
                                Showing @(((Model.CurrentPage - 1) * Model.PageSize) + 1)–@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount) of @Model.TotalCount
                            </small>
                            <nav>
                                <ul class="pagination mb-0">
                                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" asp-action="ActivityLog"
                                           asp-route-page="@(Model.CurrentPage - 1)"
                                           asp-route-searchUser="@Model.SearchUser" asp-route-action="@Model.ActionFilter"
                                           asp-route-entity="@Model.EntityFilter" asp-route-dateFrom="@Model.DateFrom"
                                           asp-route-dateTo="@Model.DateTo">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                    @{
                                        int startPage = Math.Max(1, Model.CurrentPage - 3);
                                        int endPage = Math.Min(Model.TotalPages, startPage + 6);
                                        startPage = Math.Max(1, endPage - 6);
                                    }
                                    @if (startPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" asp-action="ActivityLog" asp-route-page="1"
                                               asp-route-searchUser="@Model.SearchUser" asp-route-action="@Model.ActionFilter"
                                               asp-route-entity="@Model.EntityFilter" asp-route-dateFrom="@Model.DateFrom"
                                               asp-route-dateTo="@Model.DateTo">1</a>
                                        </li>
                                        @if (startPage > 2)
                                        {
                                            <li class="page-item disabled"><span class="page-link">...</span></li>
                                        }
                                    }
                                    @for (int i = startPage; i <= endPage; i++)
                                    {
                                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                            <a class="page-link" asp-action="ActivityLog" asp-route-page="@i"
                                               asp-route-searchUser="@Model.SearchUser" asp-route-action="@Model.ActionFilter"
                                               asp-route-entity="@Model.EntityFilter" asp-route-dateFrom="@Model.DateFrom"
                                               asp-route-dateTo="@Model.DateTo">@i</a>
                                        </li>
                                    }
                                    @if (endPage < Model.TotalPages)
                                    {
                                        @if (endPage < Model.TotalPages - 1)
                                        {
                                            <li class="page-item disabled"><span class="page-link">...</span></li>
                                        }
                                        <li class="page-item">
                                            <a class="page-link" asp-action="ActivityLog" asp-route-page="@Model.TotalPages"
                                               asp-route-searchUser="@Model.SearchUser" asp-route-action="@Model.ActionFilter"
                                               asp-route-entity="@Model.EntityFilter" asp-route-dateFrom="@Model.DateFrom"
                                               asp-route-dateTo="@Model.DateTo">@Model.TotalPages</a>
                                        </li>
                                    }
                                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                        <a class="page-link" asp-action="ActivityLog"
                                           asp-route-page="@(Model.CurrentPage + 1)"
                                           asp-route-searchUser="@Model.SearchUser" asp-route-action="@Model.ActionFilter"
                                           asp-route-entity="@Model.EntityFilter" asp-route-dateFrom="@Model.DateFrom"
                                           asp-route-dateTo="@Model.DateTo">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-journal-text display-4 text-muted"></i>
                    <p class="text-muted mt-2">No activity log entries found.</p>
                    <a asp-action="ActivityLog" class="btn btn-outline-primary">Clear Filters</a>
                </div>
            }
        </div>
    </div>
</div>
