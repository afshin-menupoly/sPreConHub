@model PreConHub.Models.ViewModels.UserListViewModel
@{
    ViewData["Title"] = "Manage Users";

    // Sort helper: returns the toggled direction for a column
    string NextDir(string col) =>
        Model.SortBy == col && Model.SortDir == "asc" ? "desc" : "asc";

    string SortIcon(string col)
    {
        if (Model.SortBy != col) return "bi-arrow-down-up text-muted";
        return Model.SortDir == "asc" ? "bi-sort-alpha-down" : "bi-sort-alpha-up";
    }
}

<div class="container-fluid py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <nav aria-label="breadcrumb">
                <ol class="breadcrumb mb-1">
                    <li class="breadcrumb-item"><a asp-action="Dashboard">Admin</a></li>
                    <li class="breadcrumb-item active">Users</li>
                </ol>
            </nav>
            <h1 class="h3 mb-0"><i class="bi bi-people me-2"></i>Manage Users</h1>
        </div>
        <div>
            <a asp-action="CreateUser" class="btn btn-success me-2">
                <i class="bi bi-person-plus me-1"></i>Create User
            </a>
            <span class="badge bg-secondary fs-6">@Model.TotalCount users</span>
        </div>
    </div>

    <!-- Messages -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle me-2"></i>@TempData["Success"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    <!-- Filters -->
    <div class="card border-0 shadow-sm mb-4">
        <div class="card-body">
            <form method="get" class="row g-3" id="filterForm">
                <input type="hidden" name="sortBy" value="@Model.SortBy" />
                <input type="hidden" name="sortDir" value="@Model.SortDir" />
                <input type="hidden" name="pageSize" value="@Model.PageSize" />
                <div class="col-md-3">
                    <label class="form-label">Search</label>
                    <div class="input-group">
                        <span class="input-group-text"><i class="bi bi-search"></i></span>
                        <input type="text" name="search" class="form-control"
                               placeholder="Name, email, or company..." value="@Model.Search">
                    </div>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Builder</label>
                    <select name="builder" id="builderSelect" class="form-select">
                        <option value="">All Builders</option>
                        @foreach (var b in Model.Builders)
                        {
                            if (Model.BuilderFilter == b.Id)
                            {
                                <option value="@b.Id" selected>@b.Name</option>
                            }
                            else
                            {
                                <option value="@b.Id">@b.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Project</label>
                    <select name="project" id="projectSelect" class="form-select" disabled="@(string.IsNullOrWhiteSpace(Model.BuilderFilter))">
                        <option value="">All Projects</option>
                        @foreach (var p in Model.Projects)
                        {
                            if (Model.ProjectFilter == p.Id)
                            {
                                <option value="@p.Id" selected>@p.Name</option>
                            }
                            else
                            {
                                <option value="@p.Id">@p.Name</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">User Type</label>
                    <select name="userType" class="form-select">
                        <option value="">All Types</option>
                        @foreach (var ut in new[] { ("Builder", "Builders"), ("Purchaser", "Purchasers"), ("Lawyer", "Lawyers"), ("MarketingAgency", "Marketing Agencies"), ("PlatformAdmin", "Admins") })
                        {
                            if (Model.UserTypeFilter == ut.Item1)
                            {
                                <option value="@ut.Item1" selected>@ut.Item2</option>
                            }
                            else
                            {
                                <option value="@ut.Item1">@ut.Item2</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-2">
                    <label class="form-label">Status</label>
                    <select name="status" class="form-select">
                        <option value="">All Status</option>
                        @foreach (var s in new[] { ("active", "Active"), ("inactive", "Inactive") })
                        {
                            if (Model.StatusFilter == s.Item1)
                            {
                                <option value="@s.Item1" selected>@s.Item2</option>
                            }
                            else
                            {
                                <option value="@s.Item1">@s.Item2</option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-1 d-flex align-items-end">
                    <button type="submit" class="btn btn-primary w-100">
                        <i class="bi bi-funnel me-1"></i>Filter
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Users Table -->
    <div class="card border-0 shadow-sm">
        <div class="card-body p-0">
            @if (Model.Users.Any())
            {
                <div class="table-responsive">
                    <table class="table table-hover align-middle mb-0">
                        <thead class="table-light">
                            <tr>
                                <th>
                                    <a asp-action="Users"
                                       asp-route-search="@Model.Search" asp-route-userType="@Model.UserTypeFilter"
                                       asp-route-status="@Model.StatusFilter" asp-route-builder="@Model.BuilderFilter"
                                       asp-route-project="@Model.ProjectFilter" asp-route-pageSize="@Model.PageSize"
                                       asp-route-sortBy="name" asp-route-sortDir="@NextDir("name")"
                                       class="text-decoration-none text-dark">
                                        User <i class="bi @SortIcon("name") ms-1"></i>
                                    </a>
                                </th>
                                <th>
                                    <a asp-action="Users"
                                       asp-route-search="@Model.Search" asp-route-userType="@Model.UserTypeFilter"
                                       asp-route-status="@Model.StatusFilter" asp-route-builder="@Model.BuilderFilter"
                                       asp-route-project="@Model.ProjectFilter" asp-route-pageSize="@Model.PageSize"
                                       asp-route-sortBy="type" asp-route-sortDir="@NextDir("type")"
                                       class="text-decoration-none text-dark">
                                        Type <i class="bi @SortIcon("type") ms-1"></i>
                                    </a>
                                </th>
                                <th>Invited By</th>
                                <th>Status</th>
                                <th>Last Login</th>
                                <th>Registered</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var user in Model.Users)
                            {
                                <tr>
                                    <td>
                                        <div class="d-flex align-items-center">
                                            <div class="avatar-circle me-3 @(user.IsActive ? "bg-primary" : "bg-secondary") text-white">
                                                @(user.FullName.Length > 0 ? user.FullName[0].ToString().ToUpper() : "?")
                                            </div>
                                            <div>
                                                <strong>@user.FullName</strong>
                                                <br>
                                                <small class="text-muted">@user.Email</small>
                                            </div>
                                        </div>
                                    </td>
                                    <td>
                                        <span class="badge @user.UserTypeBadgeClass">@user.UserType</span>
                                        @if (user.IsSuperAdmin)
                                        {
                                            <span class="badge bg-dark ms-1">SuperAdmin</span>
                                        }
                                    </td>
                                    <td>
                                        @if (!string.IsNullOrEmpty(user.InvitedByName))
                                        {
                                            <a asp-action="UserDetail" asp-route-id="@user.InvitedByUserId" class="text-decoration-none">
                                                <small>@user.InvitedByName</small>
                                            </a>
                                        }
                                        else
                                        {
                                            <small class="text-muted">—</small>
                                        }
                                    </td>
                                    <td>
                                        @if (user.IsActive)
                                        {
                                            <span class="badge bg-success"><i class="bi bi-check-circle me-1"></i>Active</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-secondary"><i class="bi bi-x-circle me-1"></i>Inactive</span>
                                        }
                                        @if (!user.EmailConfirmed)
                                        {
                                            <br><small class="text-warning"><i class="bi bi-envelope-exclamation me-1"></i>Email not verified</small>
                                        }
                                    </td>
                                    <td>
                                        <span class="@(user.LastLoginAt.HasValue ? "" : "text-muted")">
                                            @user.LastLoginDisplay
                                        </span>
                                    </td>
                                    <td>
                                        @user.CreatedAt.ToString("MMM dd, yyyy")
                                    </td>
                                    <td class="text-end">
                                        <div class="btn-group btn-group-sm">
                                            <a asp-action="UserDetail" asp-route-id="@user.UserId"
                                               class="btn btn-outline-primary" title="View Details">
                                                <i class="bi bi-eye"></i>
                                            </a>
                                            @if (!user.IsSuperAdmin || User.IsInRole("SuperAdmin"))
                                            {
                                                <a asp-action="EditUser" asp-route-id="@user.UserId"
                                                   class="btn btn-outline-secondary" title="Edit">
                                                    <i class="bi bi-pencil"></i>
                                                </a>
                                                <a asp-action="DeleteUser" asp-route-id="@user.UserId"
                                                   class="btn btn-outline-danger" title="Delete">
                                                    <i class="bi bi-trash"></i>
                                                </a>
                                            }
                                            @if (user.UserType != PreConHub.Models.Entities.UserType.PlatformAdmin && !user.IsSuperAdmin)
                                            {
                                                <form asp-action="ImpersonateUser" method="post" class="d-inline">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="userId" value="@user.UserId" />
                                                    <button type="submit" class="btn btn-outline-warning" title="Login As"
                                                            onclick="return confirm('Login as @user.Email?');">
                                                        <i class="bi bi-box-arrow-in-right"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <!-- Pagination & Page Size -->
                <div class="card-footer bg-white">
                    <div class="d-flex justify-content-between align-items-center">
                        <div class="d-flex align-items-center gap-2">
                            <small class="text-muted">Show</small>
                            <select id="pageSizeSelect" class="form-select form-select-sm" style="width: auto;">
                                @foreach (var size in new[] { 20, 50, 100, 250, 500 })
                                {
                                    if (Model.PageSize == size)
                                    {
                                        <option value="@size" selected>@size</option>
                                    }
                                    else
                                    {
                                        <option value="@size">@size</option>
                                    }
                                }
                            </select>
                            <small class="text-muted">per page</small>
                        </div>

                        @if (Model.TotalPages > 1)
                        {
                            <nav>
                                <ul class="pagination mb-0">
                                    <li class="page-item @(Model.CurrentPage == 1 ? "disabled" : "")">
                                        <a class="page-link" asp-action="Users"
                                           asp-route-page="@(Model.CurrentPage - 1)"
                                           asp-route-search="@Model.Search" asp-route-userType="@Model.UserTypeFilter"
                                           asp-route-status="@Model.StatusFilter" asp-route-builder="@Model.BuilderFilter"
                                           asp-route-project="@Model.ProjectFilter" asp-route-sortBy="@Model.SortBy"
                                           asp-route-sortDir="@Model.SortDir" asp-route-pageSize="@Model.PageSize">
                                            <i class="bi bi-chevron-left"></i>
                                        </a>
                                    </li>
                                    @{
                                        // Smart pagination: show max 7 page buttons
                                        int startPage = Math.Max(1, Model.CurrentPage - 3);
                                        int endPage = Math.Min(Model.TotalPages, startPage + 6);
                                        startPage = Math.Max(1, endPage - 6);
                                    }
                                    @if (startPage > 1)
                                    {
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Users" asp-route-page="1"
                                               asp-route-search="@Model.Search" asp-route-userType="@Model.UserTypeFilter"
                                               asp-route-status="@Model.StatusFilter" asp-route-builder="@Model.BuilderFilter"
                                               asp-route-project="@Model.ProjectFilter" asp-route-sortBy="@Model.SortBy"
                                               asp-route-sortDir="@Model.SortDir" asp-route-pageSize="@Model.PageSize">1</a>
                                        </li>
                                        @if (startPage > 2)
                                        {
                                            <li class="page-item disabled"><span class="page-link">...</span></li>
                                        }
                                    }
                                    @for (int i = startPage; i <= endPage; i++)
                                    {
                                        <li class="page-item @(i == Model.CurrentPage ? "active" : "")">
                                            <a class="page-link" asp-action="Users" asp-route-page="@i"
                                               asp-route-search="@Model.Search" asp-route-userType="@Model.UserTypeFilter"
                                               asp-route-status="@Model.StatusFilter" asp-route-builder="@Model.BuilderFilter"
                                               asp-route-project="@Model.ProjectFilter" asp-route-sortBy="@Model.SortBy"
                                               asp-route-sortDir="@Model.SortDir" asp-route-pageSize="@Model.PageSize">@i</a>
                                        </li>
                                    }
                                    @if (endPage < Model.TotalPages)
                                    {
                                        @if (endPage < Model.TotalPages - 1)
                                        {
                                            <li class="page-item disabled"><span class="page-link">...</span></li>
                                        }
                                        <li class="page-item">
                                            <a class="page-link" asp-action="Users" asp-route-page="@Model.TotalPages"
                                               asp-route-search="@Model.Search" asp-route-userType="@Model.UserTypeFilter"
                                               asp-route-status="@Model.StatusFilter" asp-route-builder="@Model.BuilderFilter"
                                               asp-route-project="@Model.ProjectFilter" asp-route-sortBy="@Model.SortBy"
                                               asp-route-sortDir="@Model.SortDir" asp-route-pageSize="@Model.PageSize">@Model.TotalPages</a>
                                        </li>
                                    }
                                    <li class="page-item @(Model.CurrentPage == Model.TotalPages ? "disabled" : "")">
                                        <a class="page-link" asp-action="Users"
                                           asp-route-page="@(Model.CurrentPage + 1)"
                                           asp-route-search="@Model.Search" asp-route-userType="@Model.UserTypeFilter"
                                           asp-route-status="@Model.StatusFilter" asp-route-builder="@Model.BuilderFilter"
                                           asp-route-project="@Model.ProjectFilter" asp-route-sortBy="@Model.SortBy"
                                           asp-route-sortDir="@Model.SortDir" asp-route-pageSize="@Model.PageSize">
                                            <i class="bi bi-chevron-right"></i>
                                        </a>
                                    </li>
                                </ul>
                            </nav>
                        }

                        <small class="text-muted">
                            Showing @(((Model.CurrentPage - 1) * Model.PageSize) + 1)–@Math.Min(Model.CurrentPage * Model.PageSize, Model.TotalCount) of @Model.TotalCount
                        </small>
                    </div>
                </div>
            }
            else
            {
                <div class="text-center py-5">
                    <i class="bi bi-people display-4 text-muted"></i>
                    <p class="text-muted mt-2">No users found matching your criteria.</p>
                    <a asp-action="Users" class="btn btn-outline-primary">Clear Filters</a>
                </div>
            }
        </div>
    </div>
</div>

<style>
    .avatar-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: bold;
    }
    th a:hover {
        text-decoration: underline !important;
    }
</style>

@section Scripts {
<script>
    // Builder → Project AJAX cascade
    document.getElementById('builderSelect').addEventListener('change', function () {
        var builderId = this.value;
        var projectSelect = document.getElementById('projectSelect');

        // Reset project dropdown
        projectSelect.innerHTML = '<option value="">All Projects</option>';

        if (!builderId) {
            projectSelect.disabled = true;
            return;
        }

        projectSelect.disabled = false;
        fetch('@Url.Action("GetProjectsByBuilder")' + '?builderId=' + encodeURIComponent(builderId))
            .then(function (response) { return response.json(); })
            .then(function (projects) {
                projects.forEach(function (p) {
                    var opt = document.createElement('option');
                    opt.value = p.id;
                    opt.textContent = p.name;
                    projectSelect.appendChild(opt);
                });
            });
    });

    // Page size change → resubmit with page 1
    document.getElementById('pageSizeSelect').addEventListener('change', function () {
        var form = document.getElementById('filterForm');
        // Update the hidden pageSize input
        form.querySelector('input[name="pageSize"]').value = this.value;
        form.submit();
    });
</script>
}
